{
  "name": "@local/conest-connector",
  "version": "0.6.4",
  "description": "CoNest Connector for OpenClaw, with the CoNest Runtime for DSH/Cordis components.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "packageManager": "pnpm@11.7.0",
  "bin": {
    "conest": "./dist/cli.js",
    "conest-local": "./dist/local-cli.js",
    "dsh-bridge": "./dist/cli.js",
    "dsh-bridge-local": "./dist/local-cli.js",
    "conest-studio": "./dist/demo-studio.mjs"
  },
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && tsx --test test/*.test.ts && node --test test/*.test.mjs",
    "test:dsh-matrix": "pnpm run build && tsx --test test/compatibility.test.ts test/component-contract.test.ts test/context-provider.test.ts test/dsh-harness.test.ts test/host-process.test.ts test/loader-runtime.test.ts test/memory.test.ts test/read.test.ts test/runtime.test.ts test/search.test.ts test/shared-host.test.ts",
    "test:openclaw": "pnpm run build && node scripts/test-openclaw.mjs",
    "test:e2e": "pnpm run build && node scripts/test-e2e.mjs",
    "test:loader": "node scripts/test-loader.mjs",
    "test:runtime": "pnpm run build && node scripts/test-runtime.mjs",
    "test:compat": "pnpm run build && node scripts/test-dsh-compat.mjs",
    "test:live:deepseek": "pnpm run build && node scripts/test-e2e.mjs --live-deepseek",
    "pack:release": "pnpm run build && node scripts/pack-release.mjs",
    "test:installation": "node scripts/test-installation.mjs",
    "benchmark": "pnpm run build && tsx scripts/benchmark.ts",
    "conest": "tsx src/cli.ts",
    "bridge": "tsx src/cli.ts",
    "demo:studio": "node scripts/demo-studio.mjs",
    "test:studio": "node scripts/demo-studio.mjs --verify",
    "bootstrap": "node scripts/maintenance/bootstrap.mjs",
    "test:components": "node scripts/demo-components.mjs",
    "demo:core": "node scripts/demo-studio.mjs --core",
    "test:core": "node scripts/demo-studio.mjs --verify --core",
    "check": "python3 scripts/maintenance/check-repository.py && python3 scripts/maintenance/test-contribution.py && pnpm run typecheck",
    "check:repo": "python3 scripts/maintenance/check-repository.py",
    "review": "node scripts/review.mjs",
    "start": "node scripts/demo-studio.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-loader": "file:.vendor/dsh/vendor/loader",
    "@deepseek-ai/cordis": "file:.vendor/dsh/vendor/cordis",
    "@deepseek-ai/dsh-llm": "file:.vendor/dsh/packages/llm/llm",
    "@deepseek-ai/dsh-subprocess-local": "file:.vendor/dsh/packages/subprocess/subprocess-local",
    "@deepseek-ai/dsh-system-prompt": "file:.vendor/dsh/packages/core/system-prompt",
    "@deepseek-ai/dsh-tool-fs-search": "file:.vendor/dsh/packages/fs/tool-fs-search",
    "@deepseek-ai/dsh-tools": "file:.vendor/dsh/packages/core/tools",
    "ajv": "8.17.1",
    "semver": "7.8.5",
    "typebox": "1.3.18",
    "sharp": "0.35.3",
    "koffi": "3.1.1",
    "@deepseek-ai/node-addon-landlock-run-linux-x64": "0.1.1",
    "@deepseek-ai/node-addon-system": "0.1.2",
    "node-pty": "1.1.0",
    "@openclaw/deepseek-provider": "2026.9.2",
    "@vscode/ripgrep": "1.18.0",
    "@deepseek-ai/dsh-sandbox-windows-acl": "file:.vendor/dsh/packages/sandbox/sandbox-windows-acl",
    "@deepseek-ai/dsh-session": "file:.vendor/dsh/packages/core/session",
    "@deepseek-ai/dsh-tool-fs": "file:.vendor/dsh/packages/fs/tool-fs",
    "@deepseek-ai/dsh-fs": "file:.vendor/dsh/packages/fs/fs",
    "@deepseek-ai/dsh-fs-local": "file:.vendor/dsh/packages/fs/fs-local",
    "@deepseek-ai/dsh-mcp-client": "file:.vendor/dsh/packages/mcp/mcp-client"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "@types/semver": "7.7.0",
    "npm": "12.0.2",
    "openclaw": "2026.9.2",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "@deepseek-ai/dsh-agent": "file:.vendor/dsh/packages/core/agent",
