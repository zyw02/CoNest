{
  "id": "source-verifier",
  "version": "1.3.0",
  "bridgeVersion": ">=0.3.0 <0.7.0",
  "description": "An independently installed verifier that depends on the DSH search service.",
  "entry": "./component.mjs",
  "requires": { "dsh-search": "^0.2.0" },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": { "label": { "type": "string", "maxLength": 100 } }
  },
  "capabilities": [{
    "name": "source_verify",
    "description": "Verify that an exact single-line quote occurs in a workspace file matching the query. Uses the declared DSH search dependency and returns source evidence.",
    "permissions": ["workspace:read"],
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\r\\n]+$" },
        "quote": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "^[^\\r\\n]+$" }
      },
      "required": ["query", "quote"]
    },
    "outputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verified": { "type": "boolean" },
        "label": { "type": "string" },
        "sources": { "type": "array", "items": {
          "type": "object",
          "properties": { "path": { "type": "string" }, "lineNumber": { "type": "integer" }, "line": { "type": "string" } },
          "required": ["path", "lineNumber", "line"],
          "additionalProperties": false
        } }
      },
      "required": ["verified", "label", "sources"]
    }
  }]
}
