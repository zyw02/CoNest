{
  "id": "office-check",
  "version": "1.0.0",
  "description": "office check",
  "entry": "component.mjs",
  "requires": {
    "office-knowledge": "^1.0.0"
  },
  "capabilities": [
    {
      "name": "office_check",
      "description": "Check required attachment against the configured policy",
      "inputSchema": {
        "type": "object",
        "properties": {
          "attachment": {
            "type": "boolean"
          },
          "delayMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000
          }
        },
        "required": [
          "attachment"
        ],
        "additionalProperties": false
      },
      "permissions": [
        "workspace:read"
      ]
    }
  ]
}
