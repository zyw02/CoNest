{
  "id": "web-fetch",
  "version": "1.0.0",
  "description": "Fetch a URL and extract clean readable text content. Similar to Jina Reader.",
  "entry": "./component.mjs",
  "requires": {},
  "capabilities": [
    {
      "name": "fetch_url",
      "description": "Fetch a web page and extract its main text content. Returns title, cleaned text, and metadata.",
      "permissions": ["workspace:read"],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^https?://" },
          "maxChars": { "type": "integer", "minimum": 500, "maximum": 50000 }
        },
        "required": ["url"]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string" },
          "statusCode": { "type": "integer" },
          "title": { "type": "string" },
          "text": { "type": "string" },
          "textLength": { "type": "integer" },
          "links": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["url", "statusCode", "title", "text", "textLength"]
      }
    }
  ]
}
