# Local-only work, worktrees and verified dependency downloads.
/.local/
/.worktrees/
/.vendor/
/.tooling
node_modules/
/dist/
/lib/
__pycache__/
*.pyc
*.log
.bridge/
.dsh/

# Credentials, private state and distributable artifacts.
.env
.env.*
!.env.example
*.private.*
*.pem
*.key
*.jsonl
*.tgz
*.tar.gz
*.zip
*.bundle

