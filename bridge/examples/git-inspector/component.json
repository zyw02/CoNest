{
  "id": "git-inspector",
  "version": "1.0.0",
  "description": "Git repository inspection: status, diff, log, and branch info for the workspace.",
  "entry": "./component.mjs",
  "requires": {},
  "capabilities": [
    {
      "name": "git_status",
      "description": "Show working tree status: current branch, modified/staged/untracked files, ahead/behind count.",
      "permissions": ["workspace:read"],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "maxLength": 500, "description": "Repository path (defaults to workspace root)" }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "branch": { "type": "string" },
          "upstream": { "type": "string" },
          "ahead": { "type": "integer" },
          "behind": { "type": "integer" },
          "modified": { "type": "array", "items": { "type": "string" } },
          "staged": { "type": "array", "items": { "type": "string" } },
          "untracked": { "type": "array", "items": { "type": "string" } },
          "isRepository": { "type": "boolean" }
        },
        "required": ["isRepository"]
      }
    },
    {
      "name": "git_log",
      "description": "Show recent commit history with author, date, message, and hash.",
      "permissions": ["workspace:read"],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "maxLength": 500 },
          "count": { "type": "integer", "minimum": 1, "maximum": 50 }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "commits": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "hash": { "type": "string" },
                "author": { "type": "string" },
                "date": { "type": "string" },
                "message": { "type": "string" }
              },
              "required": ["hash", "author", "date", "message"]
            }
          }
        },
        "required": ["commits"]
      }
    },
    {
      "name": "git_diff",
      "description": "Show the diff between working tree and HEAD, or between two commits.",
      "permissions": ["workspace:read"],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "maxLength": 500 },
          "ref": { "type": "string", "maxLength": 200, "description": "Git ref to diff against (default: HEAD)" },
          "file": { "type": "string", "maxLength": 500, "description": "Optional file path to limit diff" }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "filesChanged": { "type": "integer" },
          "insertions": { "type": "integer" },
          "deletions": { "type": "integer" },
          "diff": { "type": "string" }
        },
        "required": ["filesChanged", "insertions", "deletions", "diff"]
      }
    }
  ]
}
