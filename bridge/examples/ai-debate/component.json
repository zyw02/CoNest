{
  "id": "ai-debate",
  "version": "1.0.0",
  "description": "Multi-agent debate: two AI sub-agents argue pro/con positions, then a judge delivers a verdict. Inspired by dsh-debate.",
  "entry": "./component.mjs",
  "requires": {},
  "capabilities": [
    {
      "name": "ai_debate",
      "description": "Run a structured multi-agent debate on a given topic. Pro and con sub-agents independently argue their positions, then a neutral judge delivers a verdict. Returns the full debate transcript with winner and reasoning.",
      "permissions": [
        "workspace:read"
      ],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 5,
            "maxLength": 500,
            "description": "The debate proposition, e.g. 'Should teams adopt microservices over monoliths?'"
          },
          "rounds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3,
            "default": 2,
            "description": "Number of debate rounds (1-3). Each round has pro then con."
          }
        },
        "required": [
          "topic"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "topic": {
            "type": "string"
          },
          "rounds": {
            "type": "integer"
          },
          "winner": {
            "type": "string",
            "enum": [
              "pro",
              "con",
              "draw"
            ]
          },
          "reasoning": {
            "type": "string"
          },
          "transcript": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "round": {
                  "type": "integer"
                },
                "side": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "round",
                "side",
                "text"
              ]
            }
          },
          "judgeFullText": {
            "type": "string"
          }
        },
        "required": [
          "topic",
          "rounds",
          "winner",
          "reasoning",
          "transcript"
        ]
      }
    }
  ]
}